# ===========================
# Sharks From Space — Environment Variables
# ===========================
# Copy to .env and fill in real values.
# Never commit .env to version control.

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false
ALLOWED_ORIGINS=*

# ---- PostgreSQL + PostGIS ----
POSTGRES_USER=sharks
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=sharksfromspace
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- NASA Earthdata (get from urs.earthdata.nasa.gov) ----
NASA_EARTHDATA_USERNAME=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password
NASA_EARTHDATA_BEARER_TOKEN=your_earthdata_bearer_token

# ---- Mapbox (mobile app) ----
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# ---- ML Model ----
MODEL_PATH=./models/shark_predictor.pkl
PREDICTION_THRESHOLD=0.6

# ---- Data Pipeline ----
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_OUTPUT_DIR=./data/output
FETCH_INTERVAL_HOURS=6

# ---- Mobile App API (Expo) ----
# For local dev, use your machine's LAN IP (not localhost)
EXPO_PUBLIC_API_URL=http://localhost:8000

# ---- AWS (optional, for S3 output storage) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=sharks-from-space-data
