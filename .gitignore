# ===========================
# Sharks From Space - .gitignore
# ===========================

# ----- Node / React Native -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.expo/
dist/
web-build/
*.tsbuildinfo

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
develop-eggs/
sdist/
wheels/
*.whl
venv/
.venv/
env/

# ----- Environment & Secrets -----
.env
.env.local
.env.*.local
*.pem

# ----- Data files -----
*.nc
*.nc4
*.hdf
*.hdf5
*.tif
*.tiff
data/raw/
data/processed/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Docker -----
docker-compose.override.yml

# ----- Misc -----
*.log
coverage/
.nyc_output/
